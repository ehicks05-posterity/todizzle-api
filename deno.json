{
  "imports": {
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.4.2",
    "hono": "npm:hono@^4.6.20",
    "stripe": "npm:stripe@^17.6.0",
    "zod": "npm:zod@^3.24.1"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --env-file --watch src/main.ts",
    "start": "deno run --allow-net src/main.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },  
  "fmt": {
    "useTabs": true,
    "lineWidth": 80,
    "indentWidth": 4,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["src/"],
    "exclude": ["src/testdata/", "src/fixtures/**/*.ts"]
  }
}