{
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.20",
    "stripe": "npm:stripe@^17.6.0"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --env-file --watch main.ts",
    "start": "deno run --allow-net main.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },  
  "fmt": {
    "useTabs": true,
    "lineWidth": 80,
    "indentWidth": 4,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["src/"],
    "exclude": ["src/testdata/", "src/fixtures/**/*.ts"]
  }
}